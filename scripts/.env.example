# Copia este archivo a ".env" (mismo folder) y completa tus valores reales.
# NUNCA subas el ".env" real a git — ya está en .gitignore.

# Cadena de conexión directa a Postgres de tu proyecto Supabase.
# Sácala de: Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:tu-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# URL donde corre Ollama (por defecto, local)
OLLAMA_URL=http://localhost:11434

# Modelo de embeddings (debe coincidir con vector(768) en db/schema.sql)
OLLAMA_EMBED_MODEL=nomic-embed-text
